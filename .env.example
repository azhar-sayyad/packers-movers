# Copy to .env to run locally: cp .env.example .env
# Required: SQLite file database (Prisma + better-sqlite3)
DATABASE_URL="file:./dev.db"

# Public site URL used for sitemap.xml, robots.txt and canonical links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Dev-only admin seed credentials (change in production).
# Used by `npm run db:seed` -> prisma/seed.ts
ADMIN_EMAIL="admin@packers.local"
ADMIN_PASSWORD="change-me-in-production"